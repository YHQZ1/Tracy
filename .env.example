TRACY_ENVIRONMENT=development
TRACY_LOG_LEVEL=INFO
TRACY_DATA_DIR=data

# Tracy uses a dedicated browser profile and does not require a Moodle API token.
TRACY_MOODLE_BASE_URL=https://moodle.example.edu
TRACY_MOODLE_TOKEN=
TRACY_MOODLE_PROFILE_DIR=data/browser-profile
TRACY_MOODLE_HEADLESS=false
TRACY_TIMEZONE=Asia/Kolkata

TRACY_DATABASE_URL=postgresql+asyncpg://tracy:tracy@localhost:5432/tracy

# Tracy uses Ollama locally for grounded answer generation.
TRACY_OLLAMA_BASE_URL=http://localhost:11434
TRACY_OLLAMA_MODEL=gemma3:4b
